<?xml version="1.0" encoding="utf-8"?>
<!--
    电视版「应用表面」内容卡片（首页最近观看/更新推荐、搜索结果、收藏网格、文件列表）的
    统一焦点环。统一规范见 docs/TV-FOCUS-RING-20261004-unified-theme-ring.md：
    - 环宽唯一来源：@dimen/webhtv_focus_ring_width（3dp），禁止写死 1.5dp/2dp；
    - 环色唯一来源：?attr/tvFocusRing（= @color/tv_item_focus_ring = 主题 FOCUS 用户槽）。

    此前这里是 `1.5dp @color/white`：同一个电视首页上，功能按钮（shape_item_focused）是蓝色
    1.5dp，内容卡片是白色 1.5dp，用户报告「上面两行按钮是蓝色边框，下面的是白色边框」。
    白色还完全不随主题走——用户改主题的「焦点色」槽时卡片边框纹丝不动。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="8dp" />

    <stroke
        android:width="@dimen/webhtv_focus_ring_width"
        android:color="?attr/tvFocusRing" />

</shape>
