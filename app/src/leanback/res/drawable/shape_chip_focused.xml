<?xml version="1.0" encoding="utf-8"?>
<!--
    电视版「视频层」方角芯片（播放页解析线路 chip，宿主 view_control_vod.xml 是叠加在视频画面
    上的透明控制条）的统一焦点环。

    环宽：@dimen/webhtv_focus_ring_width（与播放页其余按钮、当前态同宽）。

    环色：?attr/tvPlayerRing。此前这里写死白色，于是同一个播放页里出现了三套环色
    （芯片白、文本按钮主题蓝、选中态绿），用户报告「按钮和播放器选中后的边框颜色也不统一」。
    播放页不能直接用 ?attr/tvFocusRing：控制条**直接叠在视频上**，浅色表 FOCUS 深蓝在
    固定深靛玻璃（shape_dialog_control_glass_panel）上只有 1.83:1，而白环在视频亮场景
    上只有 1.00:1（均为 dev1 实机实测）。tvPlayerRing 是 ThemeResolver 在「视频亮场景 +
    固定玻璃」两类极端背景上夹取到 ≥3:1 的派生色，因此它既跟随主题、又始终可见。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="4dp" />

    <padding
        android:bottom="8dp"
        android:left="12dp"
        android:right="12dp"
        android:top="8dp" />

    <stroke
        android:width="@dimen/webhtv_focus_ring_width"
        android:color="?attr/tvPlayerRing" />

</shape>
